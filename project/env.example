# MongoDB
MONGODB_URI=mongodb://localhost:27017/cura-app

# Node server
PORT=5000
NODE_ENV=development

# JWT — generate a strong random secret (e.g. openssl rand -hex 64)
# REQUIRED — server will refuse to start without this
JWT_SECRET=your-strong-random-jwt-secret-here

# Groq AI
# Get your free API key at https://console.groq.com
# REQUIRED — Python inference server will refuse to start without this
GROQ_API_KEY=your-groq-api-key-here

# Groq model to use (default: llama-3.3-70b-versatile)
# Available models depend on your Groq API key / plan.
# Recommended (if available): llama-3.3-70b-versatile
# This project is tested with: openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile
